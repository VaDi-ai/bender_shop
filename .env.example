# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Telegram ──────────────────────────────────────────
BOT_TOKEN=
WEBHOOK_URL=https://your-domain.com
WEBHOOK_SECRET=
CRM_GROUP_ID=
ADMIN_IDS=123456789,987654321

# ── AI ────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
AI_MODEL=anthropic/claude-sonnet-4
AI_MODE=off

# ── Google Sheets ─────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_SHEET_ID=

# ── Avito ─────────────────────────────────────────────
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_ADDRESS=
AVITO_PHONE=
AVITO_MANAGER=
AVITO_WEBHOOK_SECRET=

# ── Instagram ─────────────────────────────────────────
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# ── Encryption ────────────────────────────────────────
ENCRYPTION_KEY_V1=<64-char hex, generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=info  # debug, info, warn, error

# ── Monitoring ────────────────────────────────────────
SENTRY_DSN=                  # https://xxx@yyy.ingest.sentry.io/zzz (optional)

# ── Optional ──────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PORT=3000
WEBAPP_URL=https://bendershop.store
DEFAULT_STOCK_QTY=3
SHEETS_FULL_RESET=false
STOCK_WRITEOFF_ENABLED=false
