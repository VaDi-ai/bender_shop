# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Опционально: только Postgres (или другой URL) в файле .env-prisma — перекрывает DATABASE_URL выше.

# ── Telegram ──────────────────────────────────────────
BOT_TOKEN=
# Домен для setWebhook (без /shop): приоритет WEBHOOK_PUBLIC_ORIGIN → WEBHOOK_URL → WEBAPP_URL → RAILWAY_PUBLIC_DOMAIN.
# Если bendershop.store не резолвится с серверов Telegram — укажи публичный URL Railway.
WEBHOOK_PUBLIC_ORIGIN=https://xxxx.up.railway.app
WEBHOOK_URL=https://your-domain.com
WEBHOOK_SECRET=
CRM_GROUP_ID=
ADMIN_IDS=123456789,987654321

# ── AI ────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
AI_MODEL=anthropic/claude-sonnet-4
AI_MODE=off

# ── Google Sheets ─────────────────────────────────────
# Надёжнее всего указать файл (на Windows строка-с JSON в .env часто ломает private_key).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./.secrets/google-service-account.json
# Или переменная gcloud/Google SDK (любая из двух ниже достаточна):
# GOOGLE_APPLICATION_CREDENTIALS=./.secrets/google-service-account.json
# Или сырая JSON-строка (одна строка, без переносов внутри):
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_SHEET_ID=
# Полистовой товарный учёт: парсятся ВСЕ листы таблицы, кроме служебных.
# По умолчанию исключаются листы, чьё имя начинается с «не использовать» (в т.ч. «не использовать 2»).
# EXCLUDED_SHEET_PREFIX=не использовать
# EXCLUDED_SHEET_NAMES=архив,draft

# ── Avito ─────────────────────────────────────────────
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_ADDRESS=
AVITO_PHONE=
AVITO_MANAGER=
AVITO_WEBHOOK_SECRET=

# ── Instagram ─────────────────────────────────────────
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# ── Encryption ────────────────────────────────────────
# Либо один ENCRYPTION_KEY (legacy, считается V1), либо ENCRYPTION_KEY_V1, V2….
# Если задан ENCRYPTION_KEY_V1, переменная ENCRYPTION_KEY игнорируется — не задавай разные значения в обоих.
ENCRYPTION_KEY_V1=<64-char hex, generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=info  # debug, info, warn, error

# ── Monitoring ────────────────────────────────────────
SENTRY_DSN=                  # https://xxx@yyy.ingest.sentry.io/zzz (optional)

# ── Optional ──────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PORT=3000
WEBAPP_URL=https://bendershop.store
DEFAULT_STOCK_QTY=3
SHEETS_FULL_RESET=false
STOCK_WRITEOFF_ENABLED=false

# Product photos: absolute path on host. On Railway — mount path of Volume
# (например /data/photos). Локально без переменной отдаётся из
# public/uploads/products. Подробнее: docs/DEPLOYMENT.md → Product Photos.
PHOTOS_DIR=
