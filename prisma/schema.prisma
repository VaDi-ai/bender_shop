// Bender Shop — Telegram CRM
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ClientSource {
  avito
  instagram
  telegram
  shop
}

enum MessageDirection {
  in  // входящее от клиента
  out // исходящее от магазина
}

enum TaskStatus {
  pending
  done
  cancelled
}

enum TemplateType {
  followup      // догрев
  offer         // оффер / КП
  reactivation  // реактивация
  announcement  // объявление / акция
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Segment {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isDefault Boolean  @default(false)
  color     String   // например "🔵"
  createdAt DateTime @default(now())

  clients Client[]
}

model Client {
  id              Int      @id @default(autoincrement())
  name            String
  source          ClientSource
  externalId      String?       // ID на внешней платформе (Avito, Instagram и т.д.)
  segmentId       Int?
  notes           String?
  telegramTopicId Int?          // ID темы в группе Telegram CRM
  pinnedMessageId Int?          // ID закреплённого сообщения с панелью управления

  // Расширенные контактные данные
  phone           String?
  fullName        String?
  email           String?
  birthDate       DateTime?
  lastPurchaseDate DateTime?
  totalPurchases  Int      @default(0)
  totalRevenue    Decimal  @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segment      Segment?      @relation(fields: [segmentId], references: [id])
  messages     Message[]
  tags         Tag[]
  tasks        Task[]
  orders       Order[]
  reservations Reservation[]

  @@unique([source, externalId]) // один клиент per платформа
  @@index([segmentId])
}

model Message {
  id        Int              @id @default(autoincrement())
  clientId  Int
  direction MessageDirection
  text      String
  source    ClientSource     // через какой канал пришло сообщение
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([isRead])
}

model Tag {
  id         Int    @id @default(autoincrement())
  clientId   Int
  name       String
  autoAction Json?  // { trigger: string, templateId: number, delayHours: number }

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@index([name])
}

model Task {
  id          Int        @id @default(autoincrement())
  clientId    Int
  action      String     // "send_message", "change_segment", "notify_manager" и т.д.
  payload     Json       // произвольные параметры действия
  scheduledAt DateTime
  status      TaskStatus @default(pending)
  createdAt   DateTime   @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([clientId])
}

model Template {
  id   Int          @id @default(autoincrement())
  name String       @unique
  text String       // поддерживает переменные: {{name}}, {{product}} и т.д.
  type TemplateType
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  textSide  String    @default("left")
  imageFile String?
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique  // артикул товара
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  stock       Int       @default(0)  // количество на складе
  quantity    Int       @default(0)  // доступное количество
  reserved    Int       @default(0)  // зарезервировано
  categoryId  Int?
  photoUrl    String?   // URL главного фото (обратная совместимость)
  photos      String[]  // массив file_id фото товара
  isAvailable Boolean   @default(true)

  // Торговые предложения
  attributes Json?     // { "Память": ["128GB","256GB"], "Цвет": ["Черный","Белый"] }
  specs       Json?     // { "Процессор": "A18", "Экран": "6.1 дюйм" }
  badge       String?   // "ХИТ", "НОВИНКА", "АКЦИЯ"
  brand       String?   // бренд / производитель (Apple, Samsung и т.д.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category?      @relation(fields: [categoryId], references: [id])
  reservations Reservation[]
  variants     ProductVariant[]

  @@index([categoryId])
  @@index([isAvailable])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  sku       String  @unique  // артикул варианта
  price     Decimal @db.Decimal(12, 2)
  quantity  Int     @default(0)   // доступное количество
  reserved  Int     @default(0)   // зарезервировано
  inStock   Boolean @default(true)
  attributes Json   // { "Память": "256GB", "Цвет": "Черный" }
  photos    String[]              // массив file_id фото (специфичные для варианта)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([inStock])
}

model Order {
  id          Int      @id @default(autoincrement())
  clientId    Int?
  telegramId  String   // Telegram user ID из WebApp
  items       Json     // [{ productId, name, price, qty }]
  totalAmount Decimal  @db.Decimal(12, 2)
  payment     String   // "cash" | "transfer" | "card"
  status      String   @default("new")
  createdAt   DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id])

  @@index([telegramId])
  @@index([status])
  @@index([clientId])
}

enum ReservationStatus {
  active
  cancelled
  completed
}

model Reservation {
  id        Int               @id @default(autoincrement())
  clientId  Int
  productId Int
  quantity  Int
  status    ReservationStatus @default(active)
  comment   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([clientId])
  @@index([productId])
  @@index([status])
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  service   String   @unique  // например "sales_topic"
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroBanner {
  id        Int      @id @default(autoincrement())
  imageFile String
  title     String?
  subtitle  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
