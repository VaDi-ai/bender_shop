// Bender Shop — Telegram CRM
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ClientSource {
  avito
  instagram
  telegram
  shop
}

enum MessageDirection {
  in // входящее от клиента
  out // исходящее от магазина
}

enum TaskStatus {
  pending
  done
  cancelled
  failed
}

enum TemplateType {
  followup // догрев
  offer // оффер / КП
  reactivation // реактивация
  announcement // объявление / акция
}

enum ReservationStatus {
  active
  cancelled
  completed
}

// A11
enum StockMovementType {
  in
  out
  reserve
  sale
}

// A11
enum OrderStatus {
  new
  processing
  completed
  cancelled
}

// A11
enum OrderPayment {
  cash
  card
  transfer
  crm
}

enum DiscountType {
  percent
  fixed
}

enum FilterType {
  category
  brand
  attribute
  products
}

enum DeliveryType {
  pickup
  delivery
}

enum BroadcastType {
  all
  tag
  segment
}

enum MediaType {
  photo
  video
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Segment {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isDefault Boolean  @default(false)
  color     String // например "🔵"
  createdAt DateTime @default(now())

  clients Client[]
}

model Client {
  id               Int          @id @default(autoincrement())
  name             String
  source           ClientSource
  externalId       String? // ID на внешней платформе (Avito, Instagram и т.д.)
  segmentId        Int?
  notes            String?
  telegramUsername String? // @username в Telegram
  telegramTopicId  Int? // ID темы в группе Telegram CRM
  pinnedMessageId  Int? // ID закреплённого сообщения с панелью управления

  // Расширенные контактные данные (phone, email, birthDate encrypted at app layer via lib/client-crypto.ts)
  phone            String?
  fullName         String?
  email            String?
  birthDate        String?
  // Согласие на обработку ПДн: юр. факт, живёт рядом с клиентом (дублируется в SecurityLog).
  // Аддитивно, nullable — применяется на деплое через `prisma db push`.
  pdnConsentAt     DateTime?
  lastPurchaseDate DateTime?
  totalPurchases   Int       @default(0)
  totalRevenue     Decimal   @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segment      Segment?      @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  messages     Message[]
  tags         Tag[]
  tasks        Task[]
  orders       Order[]
  reservations Reservation[]

  @@unique([source, externalId]) // один клиент per платформа
  @@index([segmentId])
  @@index([phone]) // encrypted — index kept for potential prefix/existence checks
  @@index([email]) // encrypted — index kept for potential prefix/existence checks
  @@index([telegramTopicId])
  @@index([createdAt])
}

model Message {
  id        Int              @id @default(autoincrement())
  clientId  Int
  direction MessageDirection
  text      String
  source    ClientSource // через какой канал пришло сообщение
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([isRead])
  @@index([createdAt])
}

model Tag {
  id         Int    @id @default(autoincrement())
  clientId   Int
  name       String
  autoAction Json? // { trigger: string, templateId: number, delayHours: number }

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@index([name])
  @@index([clientId])
}

model Task {
  id           Int        @id @default(autoincrement())
  clientId     Int
  action       String // "send_message", "change_segment", "notify_manager" и т.д.
  payload      Json // произвольные параметры действия
  scheduledAt  DateTime
  status       TaskStatus @default(pending)
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([clientId])
  @@index([action, status])
}

model Template {
  id   Int          @id @default(autoincrement())
  name String       @unique
  text String // поддерживает переменные: {{name}}, {{product}} и т.д.
  type TemplateType
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  textSide  String   @default("left")
  imageFile String?
  createdAt DateTime @default(now())

  products Product[]
}

/// Регион витрины / доставки. В Postgres таблица `ShopRegion`, не legacy `Region`.
model Region {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  flag      String?
  currency  String?  @db.VarChar(3) // ISO, напр. RUB
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("ShopRegion")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique // артикул товара
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  // A9: stock = total physical units received into inventory; quantity = units currently available
  // to sell (decremented on sale together with stock). reserved = units held for active
  // reservations (incremented on reserve create, decremented on reserve cancel/complete).
  // stock and quantity are decremented together when a sale is confirmed via atomicSale().
  stock       Int      @default(0)
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  categoryId  Int?
  photoUrl    String? // URL главного фото (обратная совместимость)
  photos      String[] // массив file_id фото товара
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  // Торговые предложения
  attributes   Json? // { "Память": ["128GB","256GB"], "Цвет": ["Черный","Белый"] }
  specs        Json? // { "Процессор": "A18", "Экран": "6.1 дюйм" }
  badge        String? // "ХИТ", "НОВИНКА", "АКЦИЯ"
  brand        String? // бренд / производитель (Apple, Samsung и т.д.)
  avitoItemId  BigInt? // ID объявления на Avito (заполняется при маппинге)
  avitoEnabled Boolean @default(false) // Включён ли товар для Avito

  // Phase 2 — таксономия бренд → линейка → модель
  line      String? // линейка бренда из колонки «Категория»: iPhone, MacBook, Galaxy S
  sortOrder Int     @default(0) // из колонки «Порядок», 1 = верх/новее; 0 = не задан → в конец

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  variants     ProductVariant[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isFeatured])
  @@index([brand])
  @@index([name])
  @@index([avitoItemId])
  @@index([avitoEnabled])
  @@index([brand, line])
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int
  sku        String   @unique // артикул варианта
  price      Decimal  @db.Decimal(12, 2)
  quantity   Int      @default(0) // доступное количество
  // Variant-level reserved count is not tracked here; use Product.reserved for total reserved units.
  inStock    Boolean  @default(true)
  attributes Json // { "Память": "256GB", "Цвет": "Черный" }
  photos     String[] // массив file_id фото (специфичные для варианта)

  // ── Pricing & sync fields (Commit 2) ──────────────────────────────────
  costPrice           Decimal? @db.Decimal(12, 2) // Закупочная цена от поставщика
  lastSyncedCostPrice Decimal? @db.Decimal(12, 2) // Снимок закупки при последней синхронизации
  photoUrls           String[] // URL фото с хостинга (из колонки Q)

  createdAt DateTime @default(now())

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements       StockMovement[]
  promotionPrices PromotionPrice[]
  priceChanges    PriceChange[]
  reservations    Reservation[]
  orderItems      OrderItem[]

  @@index([productId])
  @@index([inStock])
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  variantId Int
  type      StockMovementType // A11
  quantity  Int // всегда положительное число
  comment   String?
  createdBy String? // telegram userId кто сделал операцию
  createdAt DateTime          @default(now())

  // Restrict: deleting a variant that has stock movements would destroy audit history.
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@index([createdAt])
  @@index([variantId, createdAt])
  @@index([type]) // A8
}

model Order {
  id              Int           @id @default(autoincrement())
  clientId        Int?
  telegramId      String // Telegram user ID из WebApp
  totalAmount     Decimal       @db.Decimal(12, 2)
  payment         OrderPayment // A11
  status          OrderStatus   @default(new) // A11
  customerName    String?
  customerPhone   String?
  deliveryType    DeliveryType?
  deliveryAddress String?
  customerComment String?
  createdAt       DateTime      @default(now())

  client Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items  OrderItem[]

  @@index([telegramId])
  @@index([status])
  @@index([clientId])
  @@index([createdAt])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  variantId       Int
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(12, 2)
  productName     String

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict: deleting a variant that has order history would corrupt financial records.
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model Reservation {
  id        Int               @id @default(autoincrement())
  clientId  Int?
  productId Int
  variantId Int?
  quantity  Int
  status    ReservationStatus @default(active)
  comment   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  client  Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([createdAt])
}

model ApiKey {
  id         Int      @id @default(autoincrement())
  service    String   @unique // например "sales_topic"
  value      String
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model HeroBanner {
  id        Int      @id @default(autoincrement())
  imageFile String
  title     String?
  subtitle  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, order]) // A7
}

model BroadcastLog {
  id              Int           @id @default(autoincrement())
  type            BroadcastType
  target          String // тег, название сегмента или "all"
  messageText     String?
  mediaFileId     String?
  mediaType       MediaType?
  totalSent       Int
  totalFailed     Int
  createdAt       DateTime      @default(now())
  createdBy       String // telegram userId администратора
  adminTelegramId BigInt?

  @@index([createdBy]) // A6
  @@index([type]) // A6
  @@index([adminTelegramId])
}

model Promotion {
  id               Int          @id @default(autoincrement())
  name             String
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(12, 2)
  filterType       FilterType
  filterValue      String
  isActive         Boolean      @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  notificationSent Boolean      @default(false)

  prices PromotionPrice[]

  @@index([isActive]) // A5
  @@index([startsAt, endsAt]) // A5
}

model PromotionPrice {
  id            Int     @id @default(autoincrement())
  promotionId   Int
  variantId     Int
  originalPrice Decimal @db.Decimal(12, 2)

  promotion Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([promotionId, variantId])
  @@index([variantId]) // A4
}

model PriceChange {
  id        Int      @id @default(autoincrement())
  variantId Int
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  source    String // "message" | "file" | "markup" | "manual" | "currency_update"
  markup    Decimal? @db.Decimal(6, 2) // наценка в %
  comment   String? // комментарий из файла (колонка G)
  createdAt DateTime @default(now())
  createdBy String

  // ADMIN-DESIGN §7.5: откат применения прайса пачкой
  batchId Int?

  variant ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch   PriceApplyBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([createdAt])
  @@index([batchId])
}

model CurrencyRate {
  id           Int      @id @default(autoincrement())
  currency     String   @unique
  rate         Decimal  @db.Decimal(12, 4)
  previousRate Decimal? @db.Decimal(12, 4)
  updatedAt    DateTime @updatedAt
}

model Supplier {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  chatId       String    @unique
  chatType     String    @default("group") // "group" | "channel" | "private"
  isActive     Boolean   @default(true)
  markup       Decimal   @default(5) @db.Decimal(5, 2)
  // ADMIN-DESIGN §7.3: срок жизни прайса; «свежая» цена = parsedAt + TTL > now (утверждено: 3 дня)
  priceTtlDays Int       @default(3)
  notes        String?
  lastPriceAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prices  SupplierPrice[]
  batches PriceApplyBatch[]

  @@index([chatId])
  @@index([isActive])
}

model SupplierPrice {
  id         Int  @id @default(autoincrement())
  supplierId Int?

  model   String
  storage String?
  ram     String?
  color   String?
  simType String?
  country String?
  price   Decimal @db.Decimal(12, 2)

  // Привязка к варианту и поставщику при прямой записи из pricing flow
  variantId    Int?
  supplierName String?
  productName  String?

  rawMessage String
  messageId  Int?
  isActive   Boolean  @default(true)
  parsedAt   DateTime @default(now())

  // ADMIN-DESIGN §7: строка живёт внутри батча разбора; протухание = parsedAt + TTL поставщика
  batchId   Int?
  expiresAt DateTime?

  supplier Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  batch    PriceApplyBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([model])
  @@index([parsedAt])
  @@index([isActive, model])
  @@index([variantId])
  @@index([batchId])
}

model SecurityLog {
  id              Int      @id @default(autoincrement())
  event           String
  details         String
  ip              String?
  adminTelegramId String?
  createdAt       DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([adminTelegramId])
}

model PriceAlias {
  id        Int      @id @default(autoincrement())
  alias     String   @unique
  productId Int?
  variantId Int?
  isIgnored Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alias])
  @@index([productId])
  @@index([variantId])
}

model Event {
  id        Int      @id @default(autoincrement())
  type      String
  clientId  Int?
  productId Int?
  data      Json?
  source    String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([clientId])
  @@index([productId])
  @@index([sessionId])
}

/// Статистика Avito объявлений (из выгрузки)
model AvitoStat {
  id                Int       @id @default(autoincrement())
  listingId         String?
  category          String?
  subcategory       String?
  parameter         String?
  title             String?
  price             Int?
  publishedAt       DateTime?
  unpublishedAt     DateTime?
  daysOnAvito       Int?
  impressions       Int?
  views             Int?
  viewConversion    Float?
  avgViewPrice      Float?
  contacts          Int?
  contactConversion Float?
  chats             Int?
  phoneLooks        Int?
  favorites         Int?
  avgContactPrice   Float?
  totalSpend        Float?
  promoSpend        Float?
  importedAt        DateTime  @default(now())

  @@index([category])
  @@index([subcategory])
  @@index([publishedAt])
}

/// Продажи (из Excel расходов)
model Sale {
  id          Int      @id @default(autoincrement())
  date        DateTime
  productName String
  quantity    Int      @default(1)
  costPrice   Float
  sellPrice   Float
  extraCost   Float    @default(0)
  profit      Float
  importedAt  DateTime @default(now())

  @@index([date])
  @@index([productName])
}

/// Ежедневная статистика Avito объявлений (API)
model AvitoItemStat {
  id            Int      @id @default(autoincrement())
  avitoItemId   String
  title         String?
  date          DateTime
  uniqViews     Int      @default(0)
  uniqContacts  Int      @default(0)
  uniqFavorites Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([avitoItemId, date])
  @@index([avitoItemId])
  @@index([date])
}

/// Правила наценки по интервалам закупочных цен.
/// Интервал [minCost, maxCost). maxCost=null означает бесконечность.
/// mode='fixed' -> price = cost + value; mode='percent' -> price = cost * (1 + value/100).
model MarkupRule {
  id        Int      @id @default(autoincrement())
  minCost   Decimal  @db.Decimal(12, 2) // включительно
  maxCost   Decimal? @db.Decimal(12, 2) // исключительно, null = бесконечность
  mode      String   @default("fixed") // 'fixed' | 'percent'
  value     Decimal  @db.Decimal(12, 2) // сумма в рублях (fixed) или процент (percent)
  // ADMIN-DESIGN §7.4: наценка по каналам; существующие правила — сайт (default)
  channel   String   @default("site") // "site" | "avito"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([minCost])
  @@index([channel, enabled])
}

// ═══════════════ ADMIN-DESIGN Этап 1 (§2, §3.3, §4.8, §7) ═══════════════

/// Доступ к /admin/api/*. Сидируется из env ADMIN_IDS при старте (role=owner, idempotent).
model AdminUser {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  name       String?
  role       String   @default("manager") // "owner" | "manager" — manager без §8 Система и вне-коридорных применений
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

/// Журнал мутаций админки «кто что менял» + источник «вернуть моё» для LWW-полей.
model AuditLog {
  id              Int      @id @default(autoincrement())
  adminTelegramId String
  action          String // "create" | "update" | "delete" | доменные ("price_batch_apply", …)
  entity          String // модель/раздел: "Product", "MarkupRule", "PriceApplyBatch", …
  entityId        String?
  before          Json?
  after           Json?
  createdAt       DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([adminTelegramId])
}

/// Журнал прогонов синка Sheets — «что не синкнулось» в UI вместо логов Railway.
model SyncRun {
  id         Int       @id @default(autoincrement())
  direction  String    @default("sheet_to_db")
  trigger    String // "cron" | "manual" | "deploy"
  startedBy  String? // telegramId админа при ручном запуске
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  rowsRead   Int?
  created    Int?
  updated    Int?
  disabled   Int?
  writebacks Int?
  errors     Json? // массив строк-ошибок/warnings прогона

  @@index([startedAt])
}

// ═══════════════ Этап 2 — обучаемый словарь атрибутов (SIM по стране) ═══════
//
// Заменяет хардкод «iPhone + Китай/Гонконг → 2 SIM, иначе eSIM» в sheets-sync.
// Правило выбирается по стране (полная строка, включая составные «Гонконг/США»)
// + опциональному бренду + максимальному modelGenFrom ≤ поколения модели.
// modelGenFrom закрывает переезды рынков на eSIM-only (US с 14, JP/AE/Канада… с 17).

/// Словарь «страна (+поколение/бренд/модель) → тип SIM».
model SimRule {
  id           Int      @id @default(autoincrement())
  /// Как в каталоге: «Индия», «Гонконг/США». null — правило не по стране (модельное/брендовое)
  country      String?
  /// lower(trim(country)) для лукапа; '' если правило не по стране
  countryNorm  String   @default("")
  /// Ограничение по бренду (null = любой)
  brand        String?
  /// Подстрока имени модели, lower — модельный оверрайд («air»); сильнее страны
  modelMatch   String?
  /// Правило действует с этого поколения (null = любое); выигрывает максимальное подходящее
  modelGenFrom Int?
  /// Канон: "2 SIM" | "eSIM" | "SIM + eSIM"
  simType      String
  /// seed — из поставки; learned — выучено владельцем (сид не перетирает learned)
  source       String   @default("seed")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([countryNorm, brand, modelMatch, modelGenFrom])
  @@index([countryNorm])
  @@index([modelMatch])
}

/// Нормализация сырых значений атрибутов к канону («2Sim» → «2 SIM»).
model AttrValueAlias {
  id        Int      @id @default(autoincrement())
  /// Ключ атрибута: "SIM", "Цвет", …
  attrKey   String
  /// lower(trim(raw)) — как пришло из листа/прайса
  rawNorm   String
  canonical String
  source    String   @default("seed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attrKey, rawNorm])
  @@index([attrKey])
}

/// Жизненный цикл разбора прайса поставщика (ADMIN-DESIGN §7.2).
model PriceApplyBatch {
  id         Int       @id @default(autoincrement())
  supplierId Int?
  source     String // "message" | "file" | "paste"
  status     String    @default("parsing") // parsing → preview → applied | discarded | rolled_back
  createdBy  String // telegramId админа
  createdAt  DateTime  @default(now())
  appliedAt  DateTime?
  stats      Json? // { строк, узнано, не узнано, вне коридора, … }

  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  prices       SupplierPrice[]
  priceChanges PriceChange[]

  @@index([status])
  @@index([createdAt])
}
