// Bender Shop — Telegram CRM
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ClientSource {
  avito
  instagram
  telegram
  shop
}

enum MessageDirection {
  in  // входящее от клиента
  out // исходящее от магазина
}

enum TaskStatus {
  pending
  done
  cancelled
  failed
}

enum TemplateType {
  followup      // догрев
  offer         // оффер / КП
  reactivation  // реактивация
  announcement  // объявление / акция
}

enum ReservationStatus {
  active
  cancelled
  completed
}

// A11
enum StockMovementType {
  in
  out
  reserve
  sale
}

// A11
enum OrderStatus {
  new
  processing
  completed
  cancelled
}

// A11
enum OrderPayment {
  cash
  card
  transfer
  crm
}

enum DiscountType {
  percent
  fixed
}

enum FilterType {
  category
  brand
  attribute
  products
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Segment {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isDefault Boolean  @default(false)
  color     String   // например "🔵"
  createdAt DateTime @default(now())

  clients Client[]
}

model Client {
  id              Int      @id @default(autoincrement())
  name            String
  source          ClientSource
  externalId      String?       // ID на внешней платформе (Avito, Instagram и т.д.)
  segmentId       Int?
  notes           String?
  telegramTopicId Int?          // ID темы в группе Telegram CRM
  pinnedMessageId Int?          // ID закреплённого сообщения с панелью управления

  // Расширенные контактные данные
  // TODO: encrypt phone/email/birthDate at the application layer for GDPR/compliance.
  //       Use the same AES-256-GCM approach from lib/crypto.ts. Requires a migration
  //       similar to scripts/encrypt-api-keys.ts before enabling.
  phone           String?
  fullName        String?
  email           String?
  birthDate       DateTime?
  lastPurchaseDate DateTime?
  totalPurchases  Int      @default(0)
  totalRevenue    Decimal  @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segment      Segment?      @relation(fields: [segmentId], references: [id])
  messages     Message[]
  tags         Tag[]
  tasks        Task[]
  orders       Order[]
  reservations Reservation[]

  @@unique([source, externalId]) // один клиент per платформа
  @@index([segmentId])
  @@index([phone])
  @@index([email])
  @@index([telegramTopicId])
  @@index([createdAt])
}

model Message {
  id        Int              @id @default(autoincrement())
  clientId  Int
  direction MessageDirection
  text      String
  source    ClientSource     // через какой канал пришло сообщение
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([isRead])
  @@index([createdAt])
}

model Tag {
  id         Int    @id @default(autoincrement())
  clientId   Int
  name       String
  autoAction Json?  // { trigger: string, templateId: number, delayHours: number }

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
  @@index([name])
}

model Task {
  id           Int        @id @default(autoincrement())
  clientId     Int
  action       String     // "send_message", "change_segment", "notify_manager" и т.д.
  payload      Json       // произвольные параметры действия
  scheduledAt  DateTime
  status       TaskStatus @default(pending)
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([clientId])
  @@index([action, status])
}

model Template {
  id   Int          @id @default(autoincrement())
  name String       @unique
  text String       // поддерживает переменные: {{name}}, {{product}} и т.д.
  type TemplateType
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  textSide  String    @default("left")
  imageFile String?
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  sku         String    @unique  // артикул товара
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  // A9: stock = total physical units on hand; quantity = stock − reserved (units available to sell).
  // Both are updated together on stockIn/stockOut; reserved is incremented on reservation create
  // and decremented on reservation cancel/complete.
  stock       Int       @default(0)
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  categoryId  Int?
  photoUrl    String?   // URL главного фото (обратная совместимость)
  photos      String[]  // массив file_id фото товара
  isAvailable Boolean   @default(true)

  // Торговые предложения
  attributes Json?     // { "Память": ["128GB","256GB"], "Цвет": ["Черный","Белый"] }
  specs       Json?     // { "Процессор": "A18", "Экран": "6.1 дюйм" }
  badge       String?   // "ХИТ", "НОВИНКА", "АКЦИЯ"
  brand       String?   // бренд / производитель (Apple, Samsung и т.д.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category?      @relation(fields: [categoryId], references: [id])
  reservations Reservation[]
  variants     ProductVariant[]

  @@index([categoryId])
  @@index([isAvailable])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  sku       String  @unique  // артикул варианта
  price     Decimal @db.Decimal(12, 2)
  quantity  Int     @default(0)   // доступное количество
  // L3: reserved field removed — reservation counts tracked at Product level via Product.reserved
  inStock   Boolean @default(true)
  attributes Json   // { "Память": "256GB", "Цвет": "Черный" }
  photos    String[]              // массив file_id фото (специфичные для варианта)

  createdAt DateTime @default(now())

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements       StockMovement[]
  promotionPrices PromotionPrice[]
  priceChanges    PriceChange[]
  reservations    Reservation[]
  orderItems      OrderItem[]

  @@index([productId])
  @@index([inStock])
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  variantId Int
  type      StockMovementType // A11
  quantity  Int               // всегда положительное число
  comment   String?
  createdBy String?           // telegram userId кто сделал операцию
  createdAt DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([createdAt])
  @@index([variantId, createdAt])
  @@index([type])             // A8
}

model Order {
  id              Int          @id @default(autoincrement())
  clientId        Int?
  telegramId      String       // Telegram user ID из WebApp
  itemsJson       Json?        // [{ variantId, name, price, quantity }] — временно, заменяется OrderItem
  totalAmount     Decimal      @db.Decimal(12, 2)
  payment         OrderPayment // A11
  status          OrderStatus  @default(new) // A11
  customerName    String?
  customerPhone   String?
  deliveryType    String?      // "pickup" | "delivery"
  deliveryAddress String?
  createdAt       DateTime     @default(now())

  client Client?      @relation(fields: [clientId], references: [id])
  items  OrderItem[]

  @@index([telegramId])
  @@index([status])
  @@index([clientId])
  @@index([createdAt])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  variantId       Int
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(12, 2)
  productName     String

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model Reservation {
  id        Int               @id @default(autoincrement())
  clientId  Int?
  productId Int
  variantId Int?
  quantity  Int
  status    ReservationStatus @default(active)
  comment   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  client  Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([clientId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([createdAt])
}

model ApiKey {
  id         Int      @id @default(autoincrement())
  service    String   @unique  // например "sales_topic"
  value      String
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Region {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  flag      String
  currency  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model HeroBanner {
  id        Int      @id @default(autoincrement())
  imageFile String
  title     String?
  subtitle  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, order])  // A7
}

model BroadcastLog {
  id               Int      @id @default(autoincrement())
  type             String   // "all" | "tag" | "segment"
  target           String   // тег, название сегмента или "all"
  messageText      String?
  mediaFileId      String?
  mediaType        String?  // "photo" | "video"
  totalSent        Int
  totalFailed      Int
  createdAt        DateTime @default(now())
  createdBy        String   // telegram userId администратора
  adminTelegramId  BigInt?

  @@index([createdBy])        // A6
  @@index([type])             // A6
  @@index([adminTelegramId])
}

model Promotion {
  id               Int          @id @default(autoincrement())
  name             String
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(12, 2)
  filterType       FilterType
  filterValue      String
  isActive         Boolean          @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  notificationSent Boolean          @default(false)

  prices PromotionPrice[]

  @@index([isActive])         // A5
  @@index([startsAt, endsAt]) // A5
}

model PromotionPrice {
  id            Int     @id @default(autoincrement())
  promotionId   Int
  variantId     Int
  originalPrice Decimal @db.Decimal(12, 2)

  promotion Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([promotionId, variantId])
  @@index([variantId])      // A4
}

model PriceChange {
  id        Int      @id @default(autoincrement())
  variantId Int
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  source    String   // "message" | "file" | "markup" | "manual" | "currency_update"
  markup    Decimal? @db.Decimal(6, 2) // наценка в %
  comment   String?  // комментарий из файла (колонка G)
  createdAt DateTime @default(now())
  createdBy String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
}

model CurrencyRate {
  id           Int      @id @default(autoincrement())
  currency     String   @unique
  rate         Decimal  @db.Decimal(12, 4)
  previousRate Decimal? @db.Decimal(12, 4)
  updatedAt    DateTime @updatedAt

  @@index([currency])
}

model SecurityLog {
  id              Int      @id @default(autoincrement())
  event           String
  details         String
  ip              String?
  adminTelegramId String?
  createdAt       DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([adminTelegramId])
}
